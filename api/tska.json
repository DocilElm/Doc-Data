{
    "version": "0.0.4",
    "changelog": ["Add DungeonTime regex"],
    "regex": {
        "Dungeons": {
            "Floor": "^  The Catacombs \\((\\w\\d)\\)$",
            "PlayerInfo": "^(?:[^\\x00-\\x7F])?(?:\\[\\d+\\] )?(?:\\[\\w+\\] )?(\\w{1,16})(?: [^\\x00-\\x7F]+)? \\((\\w+) ?(([IVXLCDM]+))?\\)$",
            "ScretsFound": "^ Secrets Found: ([\\d,.]+)$",
            "ScretsFoundPer": "^ Secrets Found: ([\\d,.]+)\\%$",
            "Milestone": "^ Your Milestone: .(.)$",
            "CompletedRooms": "^ Completed Rooms: ([\\d]+)$",
            "TeamDeaths": "^Team Deaths: ([\\d]+)$",
            "PuzzleCount": "^Puzzles: \\(([\\d]+)\\)$",
            "Crypts": "^ Crypts: ([\\d]+)$",
            "RoomSecretsFound": "([\\d]+)\\/([\\d]+) Secrets",
            "PuzzleState": "^ ([\\w ]+): \\[([✦|✔|✖])\\] ?\\(?(\\w{1,16})?\\)?$",
            "OpenedRooms": "^ Opened Rooms: (\\d+)$",
            "ClearedRooms": "^ Completed Rooms: (\\d+)$",
            "ClearedPercent": "^Cleared: (\\d+)% \\(\\d+\\)$",
            "DungeonTime": "^ Time: (?:(\\d+)h)? ?(?:(\\d+)m)? ?(?:(\\d+)s)$"
        }
    }
}